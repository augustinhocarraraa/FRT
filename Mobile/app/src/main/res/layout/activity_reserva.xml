<?xml version="1.0" encoding="utf-8"?>
<!-- O layout principal da Activity de Reserva.
     Usa um LinearLayout vertical para empilhar elementos e um ScrollView para permitir a rolagem. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".Salas.Presetation.ReservasActivity"> <!-- Corrigido para ReservaActivity, assumindo que é o nome da Activity -->

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="24dp"
      android:gravity="center_horizontal">

    <!-- NOVO: Botão de voltar personalizado (ImageButton) para a tela de reserva -->
    <ImageButton
        android:id="@+id/btn_back_arrow_reserva"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginBottom="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voltar"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_back" />

    <!-- Título da tela -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fazer Nova Reserva"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="32dp"/>

    <!-- CardView para agrupar os campos de entrada, com estilo mais moderno -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="24dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="20dp">

        <!-- Campo para exibir o nome da Sala (pode vir de uma seleção anterior) -->
        <TextView
            android:id="@+id/tv_sala_selecionada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sala Selecionada: Sala XYZ - Bloco A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="16dp"/>

        <!-- Campo de entrada para o nome do Professor -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do Professor"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/et_professor_nome"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textPersonName"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de seleção de Data -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Data da Reserva"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/et_data_reserva"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:focusable="false"
              android:clickable="true"
              android:inputType="none"
              android:drawableEnd="@android:drawable/ic_menu_today"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de seleção de Hora de Início -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hora de Início"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/et_hora_inicio"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:focusable="false"
              android:clickable="true"
              android:inputType="none"
              android:drawableEnd="@android:drawable/ic_menu_recent_history"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de seleção de Hora de Fim -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Hora de Fim"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="12dp">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/et_hora_fim"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:focusable="false"
              android:clickable="true"
              android:inputType="none"
              android:drawableEnd="@android:drawable/ic_menu_recent_history"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de entrada para a Justificativa (multiline) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Justificativa da Reserva"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">
          <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/et_justificativa"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="textMultiLine"
              android:minLines="3"
              android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>

      </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Botões de Ação -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

      <Button
          android:id="@+id/btn_cancelar_reserva"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Cancelar"
          style="?attr/materialButtonOutlinedStyle"
          android:layout_marginEnd="16dp"/>

      <Button
          android:id="@+id/btn_confirmar_reserva"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Confirmar Reserva"/>
    </LinearLayout>

    <!-- ProgressBar para indicar carregamento (oculto por padrão) -->
    <ProgressBar
        android:id="@+id/progress_bar_reserva"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

  </LinearLayout>
</ScrollView>
